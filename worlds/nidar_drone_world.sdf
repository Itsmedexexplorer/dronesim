<?xml version="1.0" ?>
<!--
  NIDAR AI Drone Simulation World - Strict 15m x 15m Covered Indoor Arena
  Complies strictly with mission specifications:
    - Arena Dimensions: 15m x 15m (-7.5m to +7.5m in X and Y, does not exceed 15m x 15m)
    - Vertical Clearance: Exactly 8 feet (2.44m) in all corridors and rooms at all times
    - Covered Top: Net-covered ceiling to simulate covered indoor / GPS-denied environment
    - Standard Room Size: 2m x 2m
    - Uniform Corridors: 1.40m clear width across all corridors (at least 1m)
    - Designated Entry & Exit Point: South-West Staging Room (-5.1m, -5.1m)
    - Damaged Building Theme: Modular maze with rooms, corridors, turns, junctions, pillars & rubble
  Sensors on Drone:
    - LiDAR 360° Laser Scanner (10 Hz, 16m range) -> /nidar/lidar
    - Waveshare IMX219-83 Stereo Depth Camera (30 FPS) -> /nidar/stereo_camera
    - Waveshare IMX335 5MP WDR Camera (30 FPS) -> /nidar/camera
-->
<sdf version="1.6">
  <world name="nidar_world">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- World Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Overhead Indoor Floodlights (Simulating bright enclosed facility illumination) -->
    <light type="directional" name="ambient_light">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <light type="point" name="facility_lamp_1">
      <pose>-3.5 -3.5 2.35 0 0 0</pose>
      <diffuse>0.65 0.65 0.68 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>12</range><constant>0.6</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light type="point" name="facility_lamp_2">
      <pose>3.5 -3.5 2.35 0 0 0</pose>
      <diffuse>0.65 0.65 0.68 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>12</range><constant>0.6</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light type="point" name="facility_lamp_3">
      <pose>-3.5 3.5 2.35 0 0 0</pose>
      <diffuse>0.65 0.65 0.68 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>12</range><constant>0.6</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light type="point" name="facility_lamp_4">
      <pose>3.5 3.5 2.35 0 0 0</pose>
      <diffuse>0.65 0.65 0.68 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>12</range><constant>0.6</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Concrete Floor -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 60</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 60</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.74 0.76 0.78 1</ambient>
            <diffuse>0.74 0.76 0.78 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Designated Entry & Exit Point Helipad (Outside South Gate at X=-5.8m, Y=-8.8m) -->
    <model name="launch_pad">
      <static>true</static>
      <pose>-5.8 -8.8 0.005 0 0 1.5708</pose>
      <link name="link">
        <visual name="pad_visual">
          <geometry>
            <cylinder>
              <radius>0.85</radius>
              <length>0.01</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.18 0.22 1</ambient>
            <diffuse>0.15 0.18 0.22 1</diffuse>
          </material>
        </visual>
        <visual name="inner_ring">
          <pose>0 0 0.006 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.35</radius>
              <length>0.002</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1.0 0.7 0.0 1</ambient>
            <diffuse>1.0 0.7 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ENTRY / EXIT Signage Banner Model (Mounted above South Gate header at Z=2.65m) -->
    <model name="entry_exit_sign">
      <static>true</static>
      <pose>-5.80 -7.48 2.65 0 0 0</pose>
      <link name="link">
        <visual name="sign_visual">
          <geometry>
            <box><size>1.6 0.04 0.30</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.85 0.1 1</ambient>
            <diffuse>0.9 0.85 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


      <static>true</static>
      <pose>-6.800 -8.650 1.220 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.080 2.300 2.440</size></box></geometry></collision>
        <visual name="vis_panel">
          <geometry><box><size>0.080 2.300 2.440</size></box></geometry>
          <material>
            <ambient>0.92 0.92 0.92 1</ambient>
            <diffuse>0.92 0.92 0.92 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <visual name="top_trim">
          <pose>0 0 1.220 0 0 0</pose>
          <geometry><box><size>0.090 2.310 0.04</size></box></geometry>
          <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>


          <geometry><cylinder><radius>0.035</radius><length>0.028</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
            <specular>0.8 0.6 0.1 1</specular>
          </material>
        </visual>

        <sensor name="lidar" type="gpu_lidar">
          <pose>0 0 0.10 0 0 0</pose>
          <topic>/nidar/lidar</topic>
          <update_rate>10</update_rate>
          <ray>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159265</min_angle>
                <max_angle>3.14159265</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.15</min>
              <max>16.0</max>
              <resolution>0.01</resolution>
            </range>
          </ray>
          <always_on>1</always_on>
          <visualize>true</visualize>
        </sensor>

        <!-- ================= SENSOR 2: Waveshare IMX219-83 Stereo Camera ================= -->
        <visual name="imx219_stereo_bar">
          <pose>0.16 0 0.025 0 0 0</pose>
          <geometry><box><size>0.02 0.085 0.024</size></box></geometry>
          <material><ambient>0.1 0.15 0.3 1</ambient><diffuse>0.1 0.15 0.3 1</diffuse></material>
        </visual>
        <visual name="imx219_left_lens">
          <pose>0.171 0.03 0.025 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.007</radius><length>0.006</length></cylinder></geometry>
          <material><ambient>0.0 0.6 0.8 1</ambient><diffuse>0.0 0.6 0.8 1</diffuse></material>
        </visual>
        <visual name="imx219_right_lens">
          <pose>0.171 -0.03 0.025 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.007</radius><length>0.006</length></cylinder></geometry>
          <material><ambient>0.0 0.6 0.8 1</ambient><diffuse>0.0 0.6 0.8 1</diffuse></material>
        </visual>

        <sensor name="imx219_stereo" type="rgbd_camera">
          <pose>0.17 0 0.025 0 0 0</pose>
          <topic>/nidar/stereo_camera</topic>
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>1.4486</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>15.0</far></clip>
            <depth_camera><clip><near>0.2</near><far>10.0</far></clip></depth_camera>
          </camera>
          <always_on>1</always_on>
          <visualize>true</visualize>
        </sensor>

        <!-- ================= SENSOR 3: Waveshare IMX335 5MP WDR Camera ================= -->
        <visual name="imx335_housing">
          <pose>0.15 0 -0.015 0 0.174 0</pose>
          <geometry><box><size>0.028 0.028 0.025</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
        <visual name="imx335_lens">
          <pose>0.165 0 -0.017 0 1.744 0</pose>
          <geometry><cylinder><radius>0.009</radius><length>0.008</length></cylinder></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>

        <sensor name="imx335_camera" type="camera">
          <pose>0.16 0 -0.015 0 0.174 0</pose>
          <topic>/nidar/camera</topic>
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>1.92</horizontal_fov>
            <image><width>1920</width><height>1080</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>50.0</far></clip>
          </camera>
          <always_on>1</always_on>
          <visualize>true</visualize>
        </sensor>

        <!-- Electronics Payload -->
        <visual name="esp32_board">
          <pose>-0.03 0.04 0.018 0 0 0</pose>
          <geometry><box><size>0.052 0.028 0.008</size></box></geometry>
          <material><ambient>0.1 0.45 0.2 1</ambient><diffuse>0.1 0.45 0.2 1</diffuse></material>
        </visual>
        <visual name="dcdc_converter">
          <pose>-0.03 -0.04 0.018 0 0 0</pose>
          <geometry><box><size>0.065 0.036 0.018</size></box></geometry>
          <material><ambient>0.15 0.25 0.5 1</ambient><diffuse>0.15 0.25 0.5 1</diffuse></material>
        </visual>
      </link>

      <!-- ================= ROTORS & JOINTS ================= -->
      <link name="X3/rotor_0">
        <pose>0.13 -0.22 0.023 0 0 0</pose>
        <inertial>
          <mass>0.005</mass>
          <inertia><ixx>9.75e-07</ixx><iyy>4.17e-05</iyy><izz>4.26e-05</izz></inertia>
        </inertial>
        <collision name="X3/rotor_0_collision">
          <geometry><cylinder><length>0.005</length><radius>0.1</radius></cylinder></geometry>
        </collision>
        <visual name="X3/rotor_0_visual">
          <geometry><mesh><scale>0.1 0.1 0.1</scale><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/x3 uav/4/files/meshes/propeller_ccw.dae</uri></mesh></geometry>
        </visual>
      </link>
      <joint name="X3/rotor_0_joint" type="revolute">
        <child>X3/rotor_0</child>
        <parent>X3/base_link</parent>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <link name="X3/rotor_1">
        <pose>-0.13 0.2 0.023 0 0 0</pose>
        <inertial>
          <mass>0.005</mass>
          <inertia><ixx>9.75e-07</ixx><iyy>4.17e-05</iyy><izz>4.26e-05</izz></inertia>
        </inertial>
        <collision name="X3/rotor_1_collision">
          <geometry><cylinder><length>0.005</length><radius>0.1</radius></cylinder></geometry>
        </collision>
        <visual name="X3/rotor_1_visual">
          <geometry><mesh><scale>0.1 0.1 0.1</scale><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/x3 uav/4/files/meshes/propeller_ccw.dae</uri></mesh></geometry>
        </visual>
      </link>
      <joint name="X3/rotor_1_joint" type="revolute">
        <child>X3/rotor_1</child>
        <parent>X3/base_link</parent>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <link name="X3/rotor_2">
        <pose>0.13 0.22 0.023 0 0 0</pose>
        <inertial>
          <mass>0.005</mass>
          <inertia><ixx>9.75e-07</ixx><iyy>4.17e-05</iyy><izz>4.26e-05</izz></inertia>
        </inertial>
        <collision name="X3/rotor_2_collision">
          <geometry><cylinder><length>0.005</length><radius>0.1</radius></cylinder></geometry>
        </collision>
        <visual name="X3/rotor_2_visual">
          <geometry><mesh><scale>0.1 0.1 0.1</scale><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/x3 uav/4/files/meshes/propeller_cw.dae</uri></mesh></geometry>
        </visual>
      </link>
      <joint name="X3/rotor_2_joint" type="revolute">
        <child>X3/rotor_2</child>
        <parent>X3/base_link</parent>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <link name="X3/rotor_3">
        <pose>-0.13 -0.2 0.023 0 0 0</pose>
        <inertial>
          <mass>0.005</mass>
          <inertia><ixx>9.75e-07</ixx><iyy>4.17e-05</iyy><izz>4.26e-05</izz></inertia>
        </inertial>
        <collision name="X3/rotor_3_collision">
          <geometry><cylinder><length>0.005</length><radius>0.1</radius></cylinder></geometry>
        </collision>
        <visual name="X3/rotor_3_visual">
          <geometry><mesh><scale>0.1 0.1 0.1</scale><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/x3 uav/4/files/meshes/propeller_cw.dae</uri></mesh></geometry>
        </visual>
      </link>
      <joint name="X3/rotor_3_joint" type="revolute">
        <child>X3/rotor_3</child>
        <parent>X3/base_link</parent>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <!-- ================= MOTOR DYNAMICS PLUGINS ================= -->
      <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>X3</robotNamespace>
        <jointName>X3/rotor_0_joint</jointName>
        <linkName>X3/rotor_0</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>950.0</maxRotVelocity>
        <motorConstant>1.15e-05</motorConstant>
        <momentConstant>0.016</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <actuator_number>0</actuator_number>
        <rotorDragCoefficient>8.06e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/0</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>

      <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>X3</robotNamespace>
        <jointName>X3/rotor_1_joint</jointName>
        <linkName>X3/rotor_1</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>950.0</maxRotVelocity>
        <motorConstant>1.15e-05</motorConstant>
        <momentConstant>0.016</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <actuator_number>1</actuator_number>
        <rotorDragCoefficient>8.06e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/1</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>

      <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>X3</robotNamespace>
        <jointName>X3/rotor_2_joint</jointName>
        <linkName>X3/rotor_2</linkName>
        <turningDirection>cw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>950.0</maxRotVelocity>
        <motorConstant>1.15e-05</motorConstant>
        <momentConstant>0.016</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <actuator_number>2</actuator_number>
        <rotorDragCoefficient>8.06e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/2</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>

      <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>X3</robotNamespace>
        <jointName>X3/rotor_3_joint</jointName>
        <linkName>X3/rotor_3</linkName>
        <turningDirection>cw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>950.0</maxRotVelocity>
        <motorConstant>1.15e-05</motorConstant>
        <momentConstant>0.016</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <actuator_number>3</actuator_number>
        <rotorDragCoefficient>8.06e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/3</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>

      <!-- ================= 1000Hz FLIGHT CONTROLLER ================= -->
      <plugin filename="gz-sim-multicopter-control-system" name="gz::sim::systems::MulticopterVelocityControl">
        <robotNamespace>X3</robotNamespace>
        <commandSubTopic>gazebo/command/twist</commandSubTopic>
        <enableSubTopic>enable</enableSubTopic>
        <comLinkName>X3/base_link</comLinkName>
        <velocityGain>2.8 2.8 3.0</velocityGain>
        <attitudeGain>2.4 3.2 0.2</attitudeGain>
        <angularRateGain>0.45 0.55 0.2</angularRateGain>
        <maximumLinearAcceleration>2.5 2.5 2.5</maximumLinearAcceleration>

        <rotorConfiguration>
          <rotor>
            <jointName>X3/rotor_0_joint</jointName>
            <forceConstant>1.15e-05</forceConstant>
            <momentConstant>0.016</momentConstant>
            <direction>1</direction>
          </rotor>
          <rotor>
            <jointName>X3/rotor_1_joint</jointName>
            <forceConstant>1.15e-05</forceConstant>
            <momentConstant>0.016</momentConstant>
            <direction>1</direction>
          </rotor>
          <rotor>
            <jointName>X3/rotor_2_joint</jointName>
            <forceConstant>1.15e-05</forceConstant>
            <momentConstant>0.016</momentConstant>
            <direction>-1</direction>
          </rotor>
          <rotor>
            <jointName>X3/rotor_3_joint</jointName>
            <forceConstant>1.15e-05</forceConstant>
            <momentConstant>0.016</momentConstant>
            <direction>-1</direction>
          </rotor>
        </rotorConfiguration>
      </plugin>

      <!-- Odometry Publisher -->
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <dimensions>3</dimensions>
      </plugin>
    </model>
  </world>
</sdf>
